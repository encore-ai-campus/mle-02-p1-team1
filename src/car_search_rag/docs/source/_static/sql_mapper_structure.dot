digraph SQLMapperStructure {
  graph [rankdir=LR, fontname="Malgun Gothic", bgcolor="white", label="현재 coffee_search 등록 실행 구조", labelloc=t];
  node [shape=box, fontname="Malgun Gothic", style=rounded];
  edge [fontname="Malgun Gothic"];
  bat [label="run_car_search.bat"];
  main [label="car_search/coffee_search.py\n로깅·세션 초기화"];
  service [label="CoffeeSearchService\nPDF·KR 추출·임베딩·등록 순서"];
  session [label="SqlSession\nmapper 등록·connection·transaction\nlogging·camelCase 결과"];
  aiosql [label="aiosql\nnamed query 로드"];
  mapper [label="*.sql\ncar_search/*.sql"];
  db [label="PostgreSQL / pgvector", shape=cylinder];
  pdf [label="group_project/data/에센자미니_c30.pdf", shape=note];
  bat -> main -> service -> session -> aiosql -> mapper -> db;
  pdf -> service;
}
