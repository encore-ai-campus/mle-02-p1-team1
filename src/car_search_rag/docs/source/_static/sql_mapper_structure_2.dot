digraph RAGStructure {
  graph [rankdir=LR, fontname="Malgun Gothic", bgcolor="white", label="현재 등록 흐름과 향후 검색·답변", labelloc=t];
  node [shape=box, fontname="Malgun Gothic", style=rounded];
  subgraph cluster_current {
    label="현재 car_search/coffee_search.py 실행";
    pdf [label="PDF"];
    kr [label="페이지 읽기 / KR 추출"];
    embed [label="Embedding"];
    store [label="머신 상세 / pgvector", shape=cylinder];
    pdf -> kr -> embed -> store;
  }
  subgraph cluster_future {
    label="향후 연결 방향 (현재 진입점에는 없음)";
    question [label="User Question"];
    qembed [label="Embedding"];
    search [label="Vector Search"];
    context [label="Retrieved Context"];
    llm [label="LLM / Answer"];
    question -> qembed -> search -> context -> llm;
  }
  store -> search [style=dashed];
}
