# 실제 값은 .env에 입력합니다. 이 파일에는 인증 정보를 넣지 않습니다.
OPENAI_API_KEY=replace-me
DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=replace-me

# 싼타페 추가 설정: 사용하지 않으면 아래 줄은 주석으로 유지합니다.
# ZZONG_DB_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
# ZZONG_SUPABASE_URL=https://SANTAFE_PROJECT.supabase.co
# ZZONG_EMBEDDING_RUN_ID=ACTIVE_EMBEDDING_RUN_UUID
